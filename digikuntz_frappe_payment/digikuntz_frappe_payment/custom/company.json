{
 "custom_fields": [
  {
   "dt": "Company",
   "fieldname": "custom_digikuntz_payment_tab",
   "fieldtype": "Tab Break",
   "label": "Digikuntz Payment",
   "insert_after": "dashboard_tab",
   "name": "Company-custom_digikuntz_payment_tab"
  },
  {
   "dt": "Company",
   "fieldname": "custom_payment_gateway",
   "fieldtype": "Select",
   "label": "Passerelle de paiement",
   "options": "\nFlutterwave\nPawaPay",
   "insert_after": "custom_digikuntz_payment_tab",
   "name": "Company-custom_payment_gateway"
  },
  {
   "dt": "Company",
   "fieldname": "custom_payment_status_html",
   "fieldtype": "HTML",
   "label": "Statut de configuration",
   "insert_after": "custom_payment_gateway",
   "name": "Company-custom_payment_status_html"
  },
  {
   "dt": "Company",
   "fieldname": "custom_flutterwave_section",
   "fieldtype": "Section Break",
   "label": "Configuration Flutterwave",
   "insert_after": "custom_payment_status_html",
   "depends_on": "eval:doc.custom_payment_gateway == 'Flutterwave'",
   "name": "Company-custom_flutterwave_section"
  },
  {
   "dt": "Company",
   "fieldname": "custom_fw_enable",
   "fieldtype": "Check",
   "label": "Activer Flutterwave",
   "default": "1",
   "insert_after": "custom_flutterwave_section",
   "name": "Company-custom_fw_enable"
  },
  {
   "dt": "Company",
   "fieldname": "custom_fw_secret_key",
   "fieldtype": "Small Text",
   "label": "Secret Key",
   "insert_after": "custom_fw_enable",
   "name": "Company-custom_fw_secret_key"
  },
  {
   "dt": "Company",
   "fieldname": "custom_fw_webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Secret",
   "insert_after": "custom_fw_secret_key",
   "name": "Company-custom_fw_webhook_secret"
  },
  {
   "dt": "Company",
   "fieldname": "custom_fw_col_break",
   "fieldtype": "Column Break",
   "insert_after": "custom_fw_webhook_secret",
   "name": "Company-custom_fw_col_break"
  },
  {
   "dt": "Company",
   "fieldname": "custom_fw_public_key",
   "fieldtype": "Data",
   "label": "Public Key",
   "insert_after": "custom_fw_col_break",
   "name": "Company-custom_fw_public_key"
  },
  {
   "dt": "Company",
   "fieldname": "custom_fw_encryption_key",
   "fieldtype": "Data",
   "label": "Encryption Key",
   "insert_after": "custom_fw_public_key",
   "name": "Company-custom_fw_encryption_key"
  },
  {
   "dt": "Company",
   "fieldname": "custom_pawapay_section",
   "fieldtype": "Section Break",
   "label": "Configuration PawaPay",
   "insert_after": "custom_fw_encryption_key",
   "depends_on": "eval:doc.custom_payment_gateway == 'PawaPay'",
   "name": "Company-custom_pawapay_section"
  },
  {
   "dt": "Company",
   "fieldname": "custom_pp_enable",
   "fieldtype": "Check",
   "label": "Activer PawaPay",
   "default": "1",
   "insert_after": "custom_pawapay_section",
   "name": "Company-custom_pp_enable"
  },
  {
   "dt": "Company",
   "fieldname": "custom_pp_secret_key",
   "fieldtype": "Small Text",
   "label": "API Token",
   "insert_after": "custom_pp_enable",
   "name": "Company-custom_pp_secret_key"
  },
  {
   "dt": "Company",
   "fieldname": "custom_pp_webhook_secret",
   "fieldtype": "Password",
   "label": "Webhook Secret",
   "insert_after": "custom_pp_secret_key",
   "name": "Company-custom_pp_webhook_secret"
  },
  {
   "dt": "Company",
   "fieldname": "custom_pp_col_break",
   "fieldtype": "Column Break",
   "insert_after": "custom_pp_webhook_secret",
   "name": "Company-custom_pp_col_break"
  },
  {
   "dt": "Company",
   "fieldname": "custom_pp_base_url",
   "fieldtype": "Data",
   "label": "API Base URL",
   "default": "https://api.pawapay.io",
   "insert_after": "custom_pp_col_break",
   "name": "Company-custom_pp_base_url"
  },
  {
   "dt": "Company",
   "fieldname": "custom_pp_environment",
   "fieldtype": "Select",
   "label": "Environnement",
   "options": "production\nsandbox",
   "default": "production",
   "insert_after": "custom_pp_base_url",
   "name": "Company-custom_pp_environment"
  },
  {
   "dt": "Company",
   "fieldname": "custom_pp_default_country",
   "fieldtype": "Data",
   "label": "Pays par défaut (ISO alpha-3)",
   "description": "Ex: CMR, SEN, CIV, GHA, ZMB",
   "insert_after": "custom_pp_environment",
   "name": "Company-custom_pp_default_country"
  },
  {
   "dt": "Company",
   "fieldname": "custom_subaccount_section",
   "fieldtype": "Section Break",
   "label": "Sous-comptes",
   "insert_after": "custom_pp_default_country",
   "depends_on": "eval:doc.custom_payment_gateway",
   "collapsible": 1,
   "name": "Company-custom_subaccount_section"
  },
  {
   "dt": "Company",
   "fieldname": "custom_activer",
   "fieldtype": "Check",
   "label": "Activer les sous-comptes",
   "insert_after": "custom_subaccount_section",
   "name": "Company-custom_activer"
  },
  {
   "dt": "Company",
   "fieldname": "custom_column_break_i4qz6",
   "fieldtype": "Column Break",
   "insert_after": "custom_activer",
   "name": "Company-custom_column_break_i4qz6"
  },
  {
   "dt": "Company",
   "fieldname": "custom_sous_compte_par_defaut",
   "fieldtype": "Link",
   "label": "Sous-compte par défaut",
   "options": "Flutterwave SubAccount",
   "insert_after": "custom_column_break_i4qz6",
   "depends_on": "eval:doc.custom_payment_gateway == 'Flutterwave' && doc.custom_activer",
   "name": "Company-custom_sous_compte_par_defaut"
  },
  {
   "dt": "Company",
   "fieldname": "custom_sous_compte_pawapay",
   "fieldtype": "Link",
   "label": "Sous-compte par défaut",
   "options": "Pawapay SubAccount",
   "insert_after": "custom_sous_compte_par_defaut",
   "depends_on": "eval:doc.custom_payment_gateway == 'PawaPay' && doc.custom_activer",
   "name": "Company-custom_sous_compte_pawapay"
  },
  {
   "dt": "Company",
   "fieldname": "custom_banque",
   "fieldtype": "Data",
   "label": "Banque",
   "insert_after": "custom_sous_compte_pawapay",
   "read_only": 1,
   "depends_on": "eval:doc.custom_activer",
   "name": "Company-custom_banque"
  },
  {
   "dt": "Company",
   "fieldname": "custom_numero_de_compte",
   "fieldtype": "Data",
   "label": "Numéro de compte",
   "insert_after": "custom_banque",
   "read_only": 1,
   "depends_on": "eval:doc.custom_activer",
   "name": "Company-custom_numero_de_compte"
  }
 ],
 "custom_perms": [],
 "doctype": "Company",
 "links": [],
 "property_setters": [],
 "sync_on_migrate": 1
}

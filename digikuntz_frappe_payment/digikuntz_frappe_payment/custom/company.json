{
 "custom_fields": [
  {
   "dt": "Company",
   "fieldname": "custom_digikuntz_payment_tab",
   "fieldtype": "Tab Break",
   "label": "Digikuntz Payment Settings",
   "insert_after": "dashboard_tab",
   "name": "Company-custom_digikuntz_payment_tab"
  },
  {
   "dt": "Company",
   "fieldname": "custom_payment_gateway",
   "fieldtype": "Select",
   "label": "Passerelle de paiement par défaut",
   "options": "\nFlutterwave\nPawaPay",
   "insert_after": "custom_digikuntz_payment_tab",
   "in_list_view": 1,
   "reqd": 0,
   "name": "Company-custom_payment_gateway"
  },
  {
   "dt": "Company",
   "fieldname": "custom_payment_status_html",
   "fieldtype": "HTML",
   "label": "Statut de configuration",
   "insert_after": "custom_payment_gateway",
   "name": "Company-custom_payment_status_html"
  },
  {
   "dt": "Company",
   "fieldname": "custom_subaccount_section",
   "fieldtype": "Section Break",
   "label": "Sous-comptes",
   "insert_after": "custom_payment_status_html",
   "depends_on": "eval:doc.custom_payment_gateway",
   "collapsible": 1,
   "name": "Company-custom_subaccount_section"
  },
  {
   "dt": "Company",
   "fieldname": "custom_activer",
   "fieldtype": "Check",
   "label": "Activer les sous-comptes",
   "insert_after": "custom_subaccount_section",
   "name": "Company-custom_activer"
  },
  {
   "dt": "Company",
   "fieldname": "custom_column_break_i4qz6",
   "fieldtype": "Column Break",
   "insert_after": "custom_activer",
   "name": "Company-custom_column_break_i4qz6"
  },
  {
   "dt": "Company",
   "fieldname": "custom_sous_compte_par_defaut",
   "fieldtype": "Link",
   "label": "Sous-compte par défaut",
   "options": "Flutterwave SubAccount",
   "insert_after": "custom_column_break_i4qz6",
   "depends_on": "eval:doc.custom_payment_gateway == 'Flutterwave' && doc.custom_activer",
   "name": "Company-custom_sous_compte_par_defaut"
  },
  {
   "dt": "Company",
   "fieldname": "custom_sous_compte_pawapay",
   "fieldtype": "Link",
   "label": "Sous-compte par défaut",
   "options": "Pawapay SubAccount",
   "insert_after": "custom_sous_compte_par_defaut",
   "depends_on": "eval:doc.custom_payment_gateway == 'PawaPay' && doc.custom_activer",
   "name": "Company-custom_sous_compte_pawapay"
  },
  {
   "dt": "Company",
   "fieldname": "custom_banque",
   "fieldtype": "Data",
   "label": "Banque",
   "insert_after": "custom_sous_compte_pawapay",
   "read_only": 1,
   "depends_on": "eval:doc.custom_activer",
   "name": "Company-custom_banque"
  },
  {
   "dt": "Company",
   "fieldname": "custom_numero_de_compte",
   "fieldtype": "Data",
   "label": "Numéro de compte",
   "insert_after": "custom_banque",
   "read_only": 1,
   "depends_on": "eval:doc.custom_activer",
   "name": "Company-custom_numero_de_compte"
  }
 ],
 "custom_perms": [],
 "doctype": "Company",
 "links": [],
 "property_setters": [],
 "sync_on_migrate": 1
}
